generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  restaurants  Restaurant[]
}

model Restaurant {
  id       Int      @id @default(autoincrement())
  name     String
  category String?
  rating   Decimal?
  userId   Int?
  user     User?    @relation(fields: [userId], references: [id])
}
